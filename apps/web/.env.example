# This fork has no accounts and no hosted API. Every value below is OPTIONAL —
# the editor runs with no .env file at all.

# Your own model-provider gateway, if you have one. Leave empty and the
# generative features report that no provider is configured.
VITE_API_URL=

# Self-hosted Umami, if you want analytics. Leave empty for no telemetry.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_DOMAINS=
